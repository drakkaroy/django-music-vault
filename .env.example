# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# sqlite3 (default, zero config) or postgresql
DB_ENGINE=postgresql
DB_NAME=django
DB_USER=django
DB_PASSWORD=django
DB_HOST=localhost
DB_PORT=5432

# --- Spotify ---
# Same app credentials power both flows:
#  - client-credentials: search/autofill, no user login needed
#  - Authorization Code: the Play button, needs each user to connect their
#    account. In your Spotify Dashboard app, add a Redirect URI matching
#    EXACTLY how you access the site (scheme+host+port+trailing slash),
#    e.g. both http://localhost:8000/spotify/callback/ and
#    http://127.0.0.1:8000/spotify/callback/ if you use either.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

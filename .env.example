# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# sqlite3 (default, zero config) or postgresql
DB_ENGINE=postgresql
DB_NAME=django
DB_USER=django
DB_PASSWORD=django
DB_HOST=localhost
DB_PORT=5432

# --- Spotify (client credentials, for search/autofill) ---
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
